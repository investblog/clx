# Headers of the files Workers Static Assets serve: the site's pages (site/), the app's page and
# their files. The API sets its own headers (src/index.ts).
# No inline script or style anywhere: geometry is set through the CSSOM (ui/). Turnstile (sign-up,
# reset) loads its script and frame from challenges.cloudflare.com.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Link: </.well-known/api-catalog>; rel="api-catalog", </llms.txt>; rel="describedby"

# For agents (site/build.ts): the catalog is a linkset (RFC 9727), the docs are markdown, the contract YAML.
/.well-known/api-catalog
  Content-Type: application/linkset+json
/*.md
  Content-Type: text/markdown; charset=utf-8
/openapi.yaml
  Content-Type: application/yaml; charset=utf-8

# The typeface (ADR 0016) changes rarely: a week in the browser. Not immutable — the names carry no
# version, so a new file under the same name must still reach readers.
/fonts/*
  Cache-Control: public, max-age=604800

# The app is a signed-in page: never indexed (the site's pages are; a 404 says noindex in its <head>).
/app
  X-Robots-Tag: noindex, nofollow
  ! Link
/ru/app
  X-Robots-Tag: noindex, nofollow
  ! Link
