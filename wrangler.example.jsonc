{
  // clx (docs/spec.md). Copy to wrangler.jsonc and fill in your own route, D1 and KV ids
  // (`wrangler d1 create clx`, `wrangler kv namespace create SESSIONS`). Tests run on this file as is.
  "name": "clx",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "clx.example.com/*", "zone_name": "example.com" }],
  // The site's pages, the app (/app) and their files (public/, built by scripts/build-ui.mjs). Sign-in, the API,
  // admin commands and worker reports go to the Worker first; everything else is a file, or the
  // nearest 404.html (ru/404.html under /ru). `/privacy.html` is served at `/privacy`, no trailing slash.
  "assets": {
    "directory": "public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/auth/*", "/v1/*", "/admin/*", "/hook/*"]
  },
  // Secrets (scripts/secrets.mjs): JWT_SECRET, MASTER_KEYS. Tests set their own (test/env.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clx",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Sessions and sign-in limits.
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "00000000000000000000000000000000" }
  ],
  // Requests per API key (§15); breakdown reports per user (§7); sign-up and reset per IP (§9).
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "REPORT_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "SIGNUP_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],
  // Every minute: install operations (docs/spec.md §4); at :20 the hourly jobs — a slice of the
  // token check (§3), expired idempotency and call-log rows.
  "triggers": { "crons": ["* * * * *"] },
  // Where clx-edge workers report: this deployment's own origin + /hook. Turnstile's site key for
  // sign-up and reset (its secret is the Worker secret TURNSTILE_SECRET).
  "vars": { "HOOK_URL": "https://clx.example.com/hook", "TURNSTILE_SITE_KEY": "" },
  // E-mail from no-reply@<your host> (Cloudflare Email Sending, Workers Paid; onboard the domain in
  // the dashboard first, until then mail reaches only the account's verified addresses).
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true }
}
