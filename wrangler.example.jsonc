{
  // clx (docs/spec.md). Copy to wrangler.jsonc and fill in your own route, D1 and KV ids
  // (`wrangler d1 create clx`, `wrangler kv namespace create SESSIONS`). Tests run on this file as is.
  "name": "clx",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "clx.example.com/*", "zone_name": "example.com" }],
  // The page and its files (public/, app.js built by scripts/build-ui.mjs). Sign-in goes to the
  // Worker first; everything else is a file or 404.
  "assets": { "directory": "public", "run_worker_first": ["/auth/*"] },
  // Secret (scripts/secrets.mjs): JWT_SECRET. Tests set their own (test/env.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clx",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Sessions and sign-in limits.
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "00000000000000000000000000000000" }],
  "observability": { "enabled": true }
}
